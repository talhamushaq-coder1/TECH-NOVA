# Firebase Cloud Functions Configuration for Order Confirmation Emails
#
# Provide your SMTP mail server credentials (e.g. Gmail App Password, SendGrid, Resend, or Mailgun):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@yourdomain.com
SMTP_PASS=your-generated-app-password
SMTP_FROM="TECHNOVA Official" <orders@technovastore.com>

# Firestore custom database ID (matches firebase-applet-config.json)
FIRESTORE_DATABASE_ID=ai-studio-technovapremiumt-fe7589e8-b91c-4b95-9589-8f598b2a6cb3

# Public Store URL for order tracking links in emails
STORE_URL=https://ais-dev-aiswyfa5ltuogyc5gsknkp-694878567962.asia-southeast1.run.app
